# Default is fully functional, deterministic Evidence Lab mode.
# It requires no paid provider and no API key.
USE_CREWAI=false

# Optional, explicit Gemini guidance for the active product workspace.
# Keep this server-side only. The browser never receives this value.
# A user must still opt in per run before minimized verified CV evidence and
# job requirements are sent to Gemini for review-only coaching.
USE_GENERATIVE_AI=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Legacy optional CrewAI/LiteLLM route (not required for the Gemini guidance
# mode above). Keep any provider key server-side only.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
