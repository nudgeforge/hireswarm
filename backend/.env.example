# Default is fully functional, deterministic Evidence Lab mode.
# It requires no paid provider and no API key.
USE_CREWAI=false

# Optional free-provider credentials. Keep them server-side only.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional: configure a provider/model accepted by your CrewAI/LiteLLM version.
# GROQ_MODEL=llama-3.1-8b-instant
# GEMINI_MODEL=gemini-3-flash-preview
